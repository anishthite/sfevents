{
  "name": "sfevents",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && npm test",
    "test": "node --test test/*.test.js",
    "dev:connector": "wrangler dev --config wrangler.connector.toml",
    "dev:app": "wrangler dev --config wrangler.app.toml",
    "deploy:connector": "wrangler deploy --config wrangler.connector.toml",
    "deploy:app": "wrangler deploy --config wrangler.app.toml",
    "events": "node scripts/sfevents.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.149.0"
  }
}